            "port": 8080,
            "targetPort": "https"
          }
        ],
        "sessionAffinity": "None",
        "internalTrafficPolicy": "Cluster",
        "publishNotReadyAddresses": false
      }
    },
    {
      "apiVersion": "policy/v1",
