{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "evidscope",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/audit": "restricted",
          "pod-security.kubernetes.io/warn": "restricted"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "vault-data",
        "namespace": "evidscope"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "vault",
        "namespace": "evidscope"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "evidscope",
            "app.kubernetes.io/component": "vault"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "evidscope",
              "app.kubernetes.io/component": "vault"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
                "topologyKey": "kubernetes.io/hostname",
                "whenUnsatisfiable": "ScheduleAnyway",
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "evidscope",
                    "app.kubernetes.io/component": "vault"
                  }
                }
              }
            ],
            "containers": [
              {
                "name": "vault",
                "image": "evidscope:local",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "MODE",
                    "value": "vault"
                  },
                  {
                    "name": "HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "PORT",
                    "value": "8080"
                  },
                  {
                    "name": "TLS_CERT_FILE",
                    "value": "/tls/tls.crt"
                  },
                  {
                    "name": "TLS_KEY_FILE",
                    "value": "/tls/tls.key"
                  },
                  {
                    "name": "DATA_DIR",
                    "value": "/data"
                  },
                  {
                    "name": "CONFIG_FILE",
                    "value": "/secrets/config.json"
                  },
                  {
                    "name": "SIGNING_KEY_FILE",
                    "value": "/keys/signing-private.pem"
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 8080
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "config",
                    "mountPath": "/secrets",
                    "readOnly": true
                  },
                  {
                    "name": "signing",
                    "mountPath": "/keys",
                    "readOnly": true
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "2000m",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "https",
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 3,
                  "timeoutSeconds": 3,
                  "failureThreshold": 2,
                  "successThreshold": 1
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "https",
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "https",
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 2,
                  "failureThreshold": 30
                }
              }
            ],
            "volumes": [
              {
                "name": "tls",
                "secret": {
                  "secretName": "vault-tls",
                  "defaultMode": 288
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "vault-data"
                }
              },
              {
                "name": "config",
                "secret": {
                  "secretName": "vault-config",
                  "defaultMode": 288
                }
              },
              {
                "name": "signing",
                "secret": {
                  "secretName": "vault-signing",
                  "defaultMode": 288
                }
              }
            ]
          }
        },
        "minReadySeconds": 3,
        "progressDeadlineSeconds": 180
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "vault",
        "namespace": "evidscope"
      },
      "spec": {
