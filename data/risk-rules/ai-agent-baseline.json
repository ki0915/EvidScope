{
  "format": "evidscope-risk-rules-v1",
  "id": "ai-agent-baseline",
  "version": 4,
  "about": "Risk rules for AI coding agents (Claude Code, Codex) collected by scripts/claude-code-hook.mjs and scripts/codex-hook.mjs. Each rule is one restricted-DSL rule of src/model.mjs on the event note (\"[Tool] command or path\", up to 1024 characters, secrets redacted) with the words operator (src/rule-words.mjs, evaluation engine v6): words in order, * for any characters, | between alternatives, a \"quoted\" word literally, a !word that must not appear (transfers to this machine itself are not flagged); a word with an upper-case letter is case-sensitive (curl -F, not curl -f). Version 1 matched a substring of the lower-cased resource, which missed reordered flags and the tail of commands over 256 characters. Version 3 adds interference with other AI agents (their global instruction files, MCP server settings, stopping their processes) and stopping EvidScope collection (its scheduled task, process, installed hook and start script). Version 4 names the programs of the guard's rules (src/agent-hook-guard.mjs v2) and of the transfer rules also by path and with a Windows extension (C:/Windows/System32/schtasks.exe, /usr/sbin/iptables, curl.exe), which version 3 missed. A match is a signal for review, not a verdict.",
  "rules": [
    {"id": "risk.cred.etc-shadow", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*/etc/shadow*", "title": "AI가 계정 비밀번호 해시 파일(/etc/shadow)에 접근했습니다"},
    {"id": "risk.cred.etc-gshadow", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*/etc/gshadow*", "title": "AI가 그룹 비밀번호 파일(/etc/gshadow)에 접근했습니다"},
    {"id": "risk.cred.sudoers", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*/etc/sudoers*", "title": "AI가 관리자 권한 설정(sudoers)에 접근했습니다"},
    {"id": "risk.cred.ssh-private-key", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*.ssh/id_* !*.ssh/id_*.pub", "title": "AI가 SSH 개인키에 접근했습니다"},
    {"id": "risk.cred.ssh-authorized-keys", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*authorized_keys*", "title": "AI가 SSH 접속 허용 키 목록에 접근했습니다"},
    {"id": "risk.cred.aws", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*.aws/credentials*", "title": "AI가 AWS 자격증명 파일에 접근했습니다"},
    {"id": "risk.cred.kube", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*.kube/config*", "title": "AI가 Kubernetes 접속 설정(자격 포함)에 접근했습니다"},
    {"id": "risk.cred.docker", "group": "credential_file", "severity": "medium", "field": "note", "op": "words", "value": "*.docker/config.json", "title": "AI가 Docker 레지스트리 자격 파일에 접근했습니다"},
    {"id": "risk.cred.git-credentials", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*.git-credentials", "title": "AI가 Git 저장 자격증명에 접근했습니다"},
    {"id": "risk.cred.netrc", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*.netrc|*/_netrc", "title": "AI가 .netrc 자격증명 파일에 접근했습니다"},
    {"id": "risk.cred.dotenv-path", "group": "credential_file", "severity": "medium", "field": "note", "op": "words", "value": "*/.env|*/.env.local|*/.env.prod|*/.env.production|*/.env.dev|*/.env.development|*/.env.staging", "title": "AI가 .env 비밀 설정 파일에 접근했습니다"},
    {"id": "risk.cred.dotenv-arg", "group": "credential_file", "severity": "medium", "field": "note", "op": "words", "value": ".env|.env.local|.env.prod|.env.production|.env.dev|.env.development|.env.staging", "title": "AI가 .env 비밀 설정 파일을 명령으로 다뤘습니다"},
    {"id": "risk.cred.windows-sam", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*system32/config/sam*", "title": "AI가 Windows 계정 데이터베이스(SAM)에 접근했습니다"},
    {"id": "risk.cred.browser-logins", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*/default/login|*/profile*/login data", "title": "AI가 브라우저 저장 비밀번호 파일에 접근했습니다"},
    {"id": "risk.cred.firefox-logins", "group": "credential_file", "severity": "high", "field": "note", "op": "words", "value": "*/logins.json|*/key4.db", "title": "AI가 Firefox 저장 비밀번호 파일에 접근했습니다"},
    {"id": "risk.cred.private-key-pem", "group": "credential_file", "severity": "medium", "field": "note", "op": "words", "value": "*private*.pem|*privkey*.pem|*-key.pem|*_key.pem|key.pem|*.pfx|*.p12|*.ppk|*private*.key|*server.key|*tls.key", "title": "AI가 개인키 파일(.pem·.pfx 등)에 접근했습니다"},
    {"id": "risk.cred.lsass", "group": "credential_theft", "severity": "high", "field": "note", "op": "words", "value": "*lsass*", "title": "AI 명령이 Windows 자격 프로세스(lsass)를 다룹니다"},
    {"id": "risk.cred.mimikatz", "group": "credential_theft", "severity": "high", "field": "note", "op": "words", "value": "*mimikatz*|*sekurlsa*", "title": "AI 명령에 자격 탈취 도구(mimikatz)가 있습니다"},
    {"id": "risk.destroy.rm-root", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "rm -*r* \"/\"|\"/*\"|\"/.\"|--no-preserve-root", "title": "AI가 루트 경로 전체 삭제 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.rm-home", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "rm -*r* \"~\"|\"~/\"|\"~/*\"|\"$home\"|\"$home/\"|\"$home/*\"", "title": "AI가 홈 폴더 전체 삭제 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.rm-glob", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "rm -*r* \"*\"|\"./*\"|\".*\"", "title": "AI가 와일드카드 일괄 삭제 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.remove-item", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "remove-item|ri -recurse|-rec* -force|-fo*", "title": "AI가 PowerShell 강제 일괄 삭제를 실행하려 했습니다"},
    {"id": "risk.destroy.remove-item-reversed", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "remove-item|ri -force|-fo* -recurse|-rec*", "title": "AI가 PowerShell 강제 일괄 삭제를 실행하려 했습니다"},
    {"id": "risk.destroy.del-s", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "del|erase|rd|rmdir /s", "title": "AI가 하위 폴더 일괄 삭제(del /s, rd /s)를 실행하려 했습니다"},
    {"id": "risk.destroy.mkfs", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "mkfs*", "title": "AI가 디스크 포맷(mkfs) 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.format", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "format \"c:\"|\"d:\"|\"e:\"|\"f:\"", "title": "AI가 드라이브 포맷 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.dd", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "dd of=/dev/sd*|of=/dev/hd*|of=/dev/disk*|of=/dev/mmcblk*", "title": "AI가 디스크 장치에 직접 쓰는 dd 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.dd-nvme", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "dd of=/dev/nvme*", "title": "AI가 디스크 장치에 직접 쓰는 dd 명령을 실행하려 했습니다"},
    {"id": "risk.destroy.git-force-push", "group": "destructive", "severity": "medium", "field": "note", "op": "words", "value": "git push --force|+*", "title": "AI가 Git 강제 푸시(이력 덮어쓰기)를 실행하려 했습니다"},
    {"id": "risk.destroy.git-force-push-f", "group": "destructive", "severity": "medium", "field": "note", "op": "words", "value": "git push -f", "title": "AI가 Git 강제 푸시(이력 덮어쓰기)를 실행하려 했습니다"},
    {"id": "risk.destroy.git-reset-hard", "group": "destructive", "severity": "medium", "field": "note", "op": "words", "value": "git reset --hard", "title": "AI가 작업 내용을 버리는 git reset --hard를 실행하려 했습니다"},
    {"id": "risk.destroy.drop-table", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "drop table", "title": "AI가 데이터베이스 테이블 삭제(DROP TABLE)를 실행하려 했습니다"},
    {"id": "risk.destroy.drop-database", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "drop database|schema", "title": "AI가 데이터베이스 삭제(DROP DATABASE)를 실행하려 했습니다"},
    {"id": "risk.destroy.shadow-copies", "group": "destructive", "severity": "high", "field": "note", "op": "words", "value": "vssadmin|vssadmin.exe|*/vssadmin|*/vssadmin.exe delete", "title": "AI가 Windows 복원 지점 삭제를 실행하려 했습니다"},
    {"id": "risk.out.curl-data", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "curl|curl.exe|*/curl|*/curl.exe -d|-d@* !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 curl로 데이터를 외부에 전송하려 했습니다"},
    {"id": "risk.out.curl-data-long", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "curl|curl.exe|*/curl|*/curl.exe --data|--data-*|--json !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 명령으로 데이터를 외부에 전송하려 했습니다"},
    {"id": "risk.out.curl-upload", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "curl|curl.exe|*/curl|*/curl.exe --upload-file !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 파일을 외부로 업로드하려 했습니다"},
    {"id": "risk.out.curl-upload-short", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "curl|curl.exe|*/curl|*/curl.exe -T !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 curl -T로 파일을 외부로 업로드하려 했습니다"},
    {"id": "risk.out.form-upload", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "curl|curl.exe|*/curl|*/curl.exe -F|--form|--form-string !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 폼 업로드로 파일을 외부에 보내려 했습니다"},
    {"id": "risk.out.wget-post", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "wget|wget.exe|*/wget|*/wget.exe --post-file*|--post-data*|--body-file* !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 wget으로 파일을 외부에 전송하려 했습니다"},
    {"id": "risk.out.ps-infile", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "invoke-webrequest|invoke-restmethod|iwr|irm -infile !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 PowerShell로 파일을 외부에 업로드하려 했습니다"},
    {"id": "risk.out.iwr-post", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "invoke-webrequest|invoke-restmethod|iwr|irm -method post|put !http://localhost*|https://localhost*|http://127.*|https://127.*|localhost:*|127.0.0.1:*|http://0.0.0.0*", "title": "AI가 PowerShell로 데이터를 외부에 전송하려 했습니다"},
    {"id": "risk.out.scp", "group": "outbound_transfer", "severity": "medium", "field": "note", "op": "words", "value": "scp|scp.exe|*/scp|*/scp.exe|pscp|pscp.exe|*/pscp|*/pscp.exe", "title": "AI가 scp로 파일을 다른 장비로 복사하려 했습니다"},
    {"id": "risk.out.netcat", "group": "outbound_transfer", "severity": "high", "field": "note", "op": "words", "value": "nc|nc.exe|*/nc|*/nc.exe|netcat|*/netcat -*", "title": "AI가 netcat으로 원격 연결을 열려 했습니다"},
    {"id": "risk.out.ncat", "group": "outbound_transfer", "severity": "high", "field": "note", "op": "words", "value": "ncat|ncat.exe|*/ncat|*/ncat.exe", "title": "AI가 netcat으로 원격 연결을 열려 했습니다"},
    {"id": "risk.out.paste-site", "group": "outbound_transfer", "severity": "high", "field": "note", "op": "words", "value": "*pastebin*|*hastebin*|*paste.ee*|*ghostbin*|*transfer.sh*|*0x0.st*|*file.io*", "title": "AI가 공개 붙여넣기 사이트에 접근했습니다"},
    {"id": "risk.defense.defender", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "set-mppreference|add-mppreference", "title": "AI가 Windows Defender 설정을 바꾸려 했습니다"},
    {"id": "risk.defense.firewall", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "netsh|netsh.exe|*/netsh|*/netsh.exe advfirewall|firewall", "title": "AI가 Windows 방화벽 설정을 바꾸려 했습니다"},
    {"id": "risk.defense.firewall-ps", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "set-netfirewallprofile -enabled false|0", "title": "AI가 Windows 방화벽을 끄려 했습니다"},
    {"id": "risk.defense.iptables-flush", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "iptables|ip6tables|*/iptables|*/ip6tables -F|--flush", "title": "AI가 방화벽 규칙을 모두 지우려 했습니다"},
    {"id": "risk.defense.selinux-off", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "setenforce|*/setenforce 0|permissive", "title": "AI가 SELinux 보호를 끄려 했습니다"},
    {"id": "risk.defense.clear-eventlog", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "wevtutil|wevtutil.exe|*/wevtutil|*/wevtutil.exe cl|clear-log", "title": "AI가 Windows 이벤트 로그를 지우려 했습니다"},
    {"id": "risk.defense.clear-eventlog-ps", "group": "defense_tampering", "severity": "high", "field": "note", "op": "words", "value": "clear-eventlog|remove-eventlog", "title": "AI가 Windows 이벤트 로그를 지우려 했습니다"},
    {"id": "risk.defense.history-clear", "group": "defense_tampering", "severity": "medium", "field": "note", "op": "words", "value": "history -c", "title": "AI가 명령 기록을 지우려 했습니다"},
    {"id": "risk.defense.history-clear-ps", "group": "defense_tampering", "severity": "medium", "field": "note", "op": "words", "value": "clear-history", "title": "AI가 명령 기록을 지우려 했습니다"},
    {"id": "risk.defense.chmod-777", "group": "defense_tampering", "severity": "medium", "field": "note", "op": "words", "value": "chmod 777|a+rwx|ugo+rwx", "title": "AI가 파일을 누구나 쓸 수 있게 권한을 풀었습니다"},
    {"id": "risk.audit.evidscope-config", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "*.evidscope/*", "title": "AI가 EvidScope 수집 설정에 접근했습니다(감시 우회 가능성)"},
    {"id": "risk.audit.claude-settings", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "*.claude/settings*", "title": "AI가 자기 hook·권한 설정 파일에 접근했습니다(감시 우회 가능성)"},
    {"id": "risk.audit.codex-hooks", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "*.codex/hooks.json", "title": "AI가 Codex hook 설정 파일에 접근했습니다(감시 우회 가능성)"},
    {"id": "risk.audit.codex-config", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "*.codex/config.toml", "title": "AI가 Codex 설정 파일에 접근했습니다(hook 끄기 등 감시 우회 가능성)"},
    {"id": "risk.agent.global-instructions", "group": "agent_interference", "severity": "medium", "field": "note", "op": "words", "value": "*/.claude/claude.md|*/.codex/agents.md|*/.codex/agents.override.md", "title": "AI가 에이전트 전역 지시 파일(CLAUDE.md·AGENTS.md)에 접근했습니다(다른 에이전트 조작 가능성)"},
    {"id": "risk.agent.mcp-config", "group": "agent_interference", "severity": "medium", "field": "note", "op": "words", "value": "*/.claude.json|\".claude.json\"|*/.mcp.json|\".mcp.json\"|*claude_desktop_config.json|*/.cursor/mcp.json", "title": "AI가 MCP 서버 설정 파일에 접근했습니다(도구 연결 조작 가능성)"},
    {"id": "risk.agent.kill-agent", "group": "agent_interference", "severity": "high", "field": "note", "op": "words", "value": "taskkill|taskkill.exe|*/taskkill|*/taskkill.exe|stop-process|pkill|*/pkill|killall|*/killall|kill|*/kill claude|claude.exe|codex|codex.exe|cursor|cursor.exe|windsurf.exe", "title": "AI가 다른 AI 에이전트 프로세스를 종료하려 했습니다"},
    {"id": "risk.agent.kill-agent-pipe", "group": "agent_interference", "severity": "high", "field": "note", "op": "words", "value": "get-process|ps|pgrep claude|claude.exe|codex|codex.exe|cursor|cursor.exe stop-process|kill|*/kill|taskkill|taskkill.exe|*/taskkill|*/taskkill.exe", "title": "AI가 다른 AI 에이전트 프로세스를 찾아 종료하려 했습니다"},
    {"id": "risk.audit.evidscope-task", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "schtasks|schtasks.exe|*/schtasks|*/schtasks.exe|disable-scheduledtask|unregister-scheduledtask|stop-scheduledtask|set-scheduledtask *evidscope* !/query", "title": "AI가 EvidScope 자동 실행 작업을 끄거나 지우려 했습니다(수집 중지 가능성)"},
    {"id": "risk.audit.evidscope-stop", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "taskkill|taskkill.exe|*/taskkill|*/taskkill.exe|stop-process|pkill|*/pkill|killall|*/killall|kill|*/kill *evidscope*", "title": "AI가 EvidScope 프로세스를 종료하려 했습니다(수집 중지 가능성)"},
    {"id": "risk.audit.hook-script", "group": "audit_tampering", "severity": "high", "field": "note", "op": "words", "value": "*/evidscope-work/hook/*|*/evidscope-work/start-evidscope.ps1", "title": "AI가 EvidScope 훅·자동 실행 스크립트에 접근했습니다(수집 중지 가능성)"}
  ]
}
