    {"id": "risk.destroy.drop-database", "group": "destructive", "severity": "high", "value": "drop database", "title": "AI가 데이터베이스 삭제(DROP DATABASE)를 실행하려 했습니다"},
    {"id": "risk.destroy.shadow-copies", "group": "destructive", "severity": "high", "value": "vssadmin delete", "title": "AI가 Windows 복원 지점 삭제를 실행하려 했습니다"},
