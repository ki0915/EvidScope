    "dev": [
      {"toolName": "Read", "filePath": "src/app.js"},
      {"toolName": "Read", "filePath": "package.json"},
      {"toolName": "Bash", "command": "git status"},
      {"toolName": "Edit", "filePath": "src/app.js"},
      {"toolName": "Bash", "command": "npm test"},
      {"toolName": "Read", "filePath": "test/app.test.js"},
      {"toolName": "Edit", "filePath": "test/app.test.js"},
      {"toolName": "Bash", "command": "npm test"},
      {"toolName": "Bash", "command": "git diff --stat"},
      {"toolName": "Bash", "command": "git add -A"},
      {"toolName": "Bash", "command": "git commit -m \"fix: handle empty input\""},
      {"toolName": "Read", "filePath": "README.md"}
    ],
    "docs": [
      {"toolName": "Read", "filePath": "docs/guide.md"},
      {"toolName": "Bash", "command": "git log --oneline -5"},
      {"toolName": "Edit", "filePath": "docs/guide.md"},
      {"toolName": "Bash", "command": "npm run lint"},
      {"toolName": "Read", "filePath": "CHANGELOG.md"},
      {"toolName": "Edit", "filePath": "CHANGELOG.md"},
      {"toolName": "Bash", "command": "npm run build"},
      {"toolName": "Bash", "command": "git add docs CHANGELOG.md"}
    ]
  },
